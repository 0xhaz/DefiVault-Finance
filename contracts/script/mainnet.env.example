# Arc mainnet deploy environment for contracts/script/DeployMainnet.s.sol
#
# Copy to a file OUTSIDE the repository (for example ~/defivault-mainnet.env), fill it in, and
# `set -a; source ~/defivault-mainnet.env; set +a`. Never commit it. It must never contain a private key:
# sign with an encrypted Foundry keystore (`cast wallet import`) and pass `--account <name> --sender $DEPLOYER_ADDRESS`.
#
# Every value marked REPLACE is a placeholder. The zero address is rejected by check(), on purpose.

# ── Network ───────────────────────────────────────────────────────────────
ARC_MAINNET_RPC=https://rpc.mainnet.arc.io     # confirm on https://docs.arc.io/arc/references/rpc-endpoints.md

# ── Governance (REPLACE all five; all must be different from the deployer) ──
DEPLOYER_ADDRESS=0x0000000000000000000000000000000000000000   # REPLACE: the address behind your keystore
OWNER_MULTISIG=0x0000000000000000000000000000000000000000     # REPLACE: Safe that will own every contract
BOARD_MULTISIG=0x0000000000000000000000000000000000000000     # REPLACE: Safe (registry board member), may equal OWNER_MULTISIG only if you decide so
CHARITY_WALLET=0x0000000000000000000000000000000000000000     # REPLACE: recipient approved by the Shariah board (SR-003)
ORACLE_OPERATOR=0x0000000000000000000000000000000000000000    # REPLACE: address allowed to write strategy scores
# ALLOW_EOA_GOVERNANCE=true                                   # NOT recommended; only if OWNER/BOARD are not contracts

# ── Parameters: no defaults, set each one deliberately (see docs/mainnet-config.md) ──
ADMIN_FEE_BPS=                  # REPLACE: Wakala fee, basis points per year (script cap 200)
MUSHARAKAH_BPS=                 # REPLACE: manager share of profit above the hurdle (script cap 3000)
HURDLE_BPS=                     # REPLACE: annual hurdle rate (script cap 2000)
EXECUTOR_MAX_GAS_PRICE_GWEI=    # REPLACE: executor gas ceiling; Arc enforces a 20 gwei minimum fee, script range 20..1000

# ── Filled in after deployCore() prints them ──────────────────────────────
# REGISTRY=
# ZAKAT=
# TREASURY=
# VAULT=
# CHARITY=
# ESCROW=
# AGGREGATOR=
# EXECUTOR=

# ── Optional gold adapters: only when every address below is confirmed on Arc mainnet ──
# GOLD_ORACLE=                      # XAU/USD feed (8 decimals); confirm it exists on Arc mainnet
# GOLD_PAXG=
# GOLD_PAXG_ROUTER=                 # Uniswap V3 SwapRouter02-style router or pool wrapper
# GOLD_PAXG_POOL_FEE=3000
# GOLD_XAUT=
# GOLD_XAUT_ROUTER=
# GOLD_XAUT_POOL_FEE=3000
# GOLD_MAX_STALENESS_SECONDS=3600
